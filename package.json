{
  "name": "@sce/plugin-template",
  "version": "0.0.101",
  "description": "Suman Chrome Extension plugin template ",
  "main": "dist/plugin.js",
  "scripts": {
    "test": "suman",
    "lint:ores": "if [ -f .ores-lint/lint.sh ]; then sh .ores-lint/lint.sh; else echo 'ores-lint not installed'; fi",
    "prepublishOnly": "npm run lint:ores"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@gitlab.com/sumanjs/sce-plugin-template.git"
  },
  "keywords": [
    "Suman",
    "Chrome",
    "Extension",
    "sce",
    "chrome-extension"
  ],
  "author": "Olegzandr VD",
  "license": "MIT",
  "bugs": {
    "url": "https://gitlab.com/sumanjs/sce-plugin-template/issues"
  },
  "homepage": "https://gitlab.com/sumanjs/sce-plugin-template#README",
  "devDependencies": {
    "@types/core-js": "^0.9.46",
    "@types/node": "^9.4.6",
    "http-server": "^0.11.1",
    "sce-plugin-typings": "latest",
    "ts-loader": "^3.5.0",
    "webpack": "^4.12.0"
  },
  "dependencies": {},
  "oresLint": {
    "note": "Declared, not installed. ores-lint resolves these from a global install - see .ores-lint/README.md",
    "requires": {
      "eslint": ">=9",
      "typescript-eslint": ">=8 (optional; without it .ts files are skipped)"
    },
    "install": "npm i -g eslint typescript-eslint"
  }
}
